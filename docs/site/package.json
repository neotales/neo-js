		"@astrojs/starlight": "0.43.1",
		"astro": "7.4.11"
	},
	"devDependencies": {
		"oxfmt": "0.79.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"packageManager": "pnpm@12.18.0"
}
